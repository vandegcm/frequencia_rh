# Copie este arquivo para .env e ajuste os caminhos para o seu ambiente.
# No Windows, caminhos podem ser informados sem aspas.

# Pasta raiz da frequencia. Deve conter as subpastas SESA e FUNEAS.
PASTA_CONTROLE_FREQUENCIA=R:\frequencia

# Pastas usadas no processamento de horas extras/META4.
PASTA_RELATORIOS_META4=R:\frequencia\HORAS EXTRAS\den\relatoriosmeta4
PASTA_EXTRAS=R:\frequencia\HORAS EXTRAS\den

# Nome da unidade exatamente como aparece nos arquivos CSV do META4.
HOSPITAL_REGIONAL=HOSPITAL REGIONAL DE FRANCISCO BELTRAO

# Rubricas que compoem as bases de calculo. Separe os codigos por virgula.
CODIGO_SALARIO_BASE=1005
CODIGOS_SV1=1005,1923,1056,1059
CODIGOS_SV2=1005,1056,1059

# Valores aceitos: true/false, yes/no, on/off, 1/0 ou sim/nao.
INCLUI_SOBREAVISO_NO_REDUTOR=false
